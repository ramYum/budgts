# Copy to .env.local and fill in. .env.local is git-ignored — never commit real values.

# --- Supabase API (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (sb_publishable_...) — client-safe, replaces the old anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_...) — server only, never sent to the browser. Optional
# until admin-level operations are needed; grab it now while you're on the page.
SUPABASE_SECRET_KEY=

# --- App ---
# Base URL for magic-link + OAuth redirect callbacks. http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Project Settings > Database > Connection string) ---
# Transaction pooler (port 6543) — app runtime queries. Fill in your DB password.
DATABASE_URL=
# Session pooler (port 5432) — Drizzle migrations only. The transaction pooler
# breaks some DDL, so migrations use this one. Fill in your DB password.
DIRECT_URL=

# --- Anthropic (V2 only: email + receipt parsing) ---
ANTHROPIC_API_KEY=

# --- Plaid (V1: bank transaction ingestion) ---
# From the Plaid dashboard (dashboard.plaid.com > Developers > API keys).
PLAID_CLIENT_ID=
# Environment-specific: the "Sandbox" value for dev/staging, "Production" for prod.
PLAID_SECRET=
# "sandbox" | "production". Defaults to "sandbox" when unset.
PLAID_ENV=sandbox
# 32 bytes of base64 — AES-256 key for encrypting the Plaid access_token at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PLAID_TOKEN_ENC_KEY=
# Shared secret the Supabase pg_cron poller presents to /api/plaid/sync-due.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
# OFF (unset) by default. Only set this AFTER registering the exact same URL
# in the Plaid dashboard (Developers > API > Allowed redirect URIs) for this
# Plaid environment (Sandbox vs Production have separate lists) — sending a
# redirect_uri Plaid doesn't have registered fails EVERY bank connection
# attempt, not just OAuth ones. Needed for OAuth-based institutions (SoFi,
# Capital One, most large US banks), which leave the app for their own login
# page and must be told where to send the browser back. Must be https in
# production. Example: https://budgts.com/plaid-oauth
PLAID_OAUTH_REDIRECT_URI=
# "1" surfaces the "Connect a bank" UI (Settings + Transactions). Leave unset in
# production until Plaid Production is approved and migration 0004 is applied
# there; the staging deploy sets it to "1".
NEXT_PUBLIC_PLAID_ENABLED=
# E2E / CI ONLY. "1" + PLAID_ENV=sandbox enables POST /api/plaid/test/seed (a
# Link-bypass that mints a Sandbox public_token). 404 otherwise. Never set in a
# real deployment.
PLAID_TEST_SEED_ENABLED=

# --- Billing (V1 subscriptions; see docs/specs/2026-09-21-v1-monetization-design.md) --------------------
# All server-only (never NEXT_PUBLIC_). Production and staging use SEPARATE RevenueCat projects and values.
# HMAC signing secret of the RevenueCat webhook integration (X-RevenueCat-Webhook-Signature).
REVENUECAT_WEBHOOK_SIGNING_SECRET=
# (Optional) the exact Authorization value the webhook integration sends; required when set.
REVENUECAT_WEBHOOK_AUTH=
# RevenueCat SECRET (server-side) REST API key, used only for reconciliation. Never put it in the mobile app.
REVENUECAT_SECRET_API_KEY=
# "production" or "sandbox": which store environment THIS deployment accepts. Unset = sandbox (refuses real-money events).
BILLING_ENVIRONMENT=
# Trial-end reminder email (Resend, transactional only). Server-only. Absent => the reminder sweep reports due
# users WITHOUT claiming them (nothing is consumed). Staging and production use separate keys.
RESEND_API_KEY=
# Verified-domain sender, e.g. "Budgts <billing@YOUR-VERIFIED-DOMAIN>". Required with RESEND_API_KEY.
EMAIL_FROM=
# Comma-separated recipient allowlist. NON-EMPTY on staging so it can never email a real customer; leave empty in production.
REMINDER_EMAIL_ALLOWLIST=
# Mobile app (public SDK keys; RevenueCat designates these as safe to ship) - set in mobile/.env or EAS, not here:
#   EXPO_PUBLIC_REVENUECAT_IOS_API_KEY / EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY

# --- Native Plaid Link (docs/specs/2026-09-21-mobile-only-transition-design.md §4A/§5) ------------------------
# iOS OAuth-institution return, as a Universal Link under the app's own domain: "<site>/app/plaid-oauth". Distinct
# from PLAID_OAUTH_REDIRECT_URI (the web page). Unset = no redirect_uri sent for native iOS Link, so most banks
# still connect but OAuth institutions (SoFi, Capital One, ...) won't complete on iOS until this is set AND the
# exact same URL is added to Plaid's dashboard Allowed redirect URIs (sending an unregistered one fails EVERY
# native iOS link-token create, not just OAuth ones). Android needs no redirect_uri — it uses ANDROID_PACKAGE_NAME
# (already defined below) instead, per Plaid's own request contract.
PLAID_NATIVE_OAUTH_REDIRECT_URI=

# --- Native app links + support (docs/specs/2026-09-21-mobile-only-transition-design.md §5) -----------------
# iOS universal links: "<10-char Apple Team ID>.<bundle id>", e.g. ABCDE12345.com.budgts.app. Unset = the
# /.well-known/apple-app-site-association route answers 404 (an association is never guessed).
APPLE_APP_ID=
# Android app links: the package name and comma-separated SHA-256 signing-certificate fingerprints (the upload key and the
# Play app-signing key). Unset = /.well-known/assetlinks.json answers 404.
ANDROID_PACKAGE_NAME=
ANDROID_CERT_SHA256=
# Contact address shown on the public /support page. Unset = the page says contact details are coming.
SUPPORT_EMAIL=
