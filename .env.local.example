# Copy to .env.local and fill in. .env.local is git-ignored — never commit real values.

# --- Supabase API (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (sb_publishable_...) — client-safe, replaces the old anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_...) — server only, never sent to the browser. Optional
# until admin-level operations are needed; grab it now while you're on the page.
SUPABASE_SECRET_KEY=

# --- App ---
# Base URL for magic-link + OAuth redirect callbacks. http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Project Settings > Database > Connection string) ---
# Transaction pooler (port 6543) — app runtime queries. Fill in your DB password.
DATABASE_URL=
# Session pooler (port 5432) — Drizzle migrations only. The transaction pooler
# breaks some DDL, so migrations use this one. Fill in your DB password.
DIRECT_URL=

# --- Anthropic (V2 only: email + receipt parsing) ---
ANTHROPIC_API_KEY=

# --- Plaid (V1: bank transaction ingestion) ---
# From the Plaid dashboard (dashboard.plaid.com > Developers > API keys).
PLAID_CLIENT_ID=
# Environment-specific: the "Sandbox" value for dev/staging, "Production" for prod.
PLAID_SECRET=
# "sandbox" | "production". Defaults to "sandbox" when unset.
PLAID_ENV=sandbox
# 32 bytes of base64 — AES-256 key for encrypting the Plaid access_token at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PLAID_TOKEN_ENC_KEY=
# Shared secret the Supabase pg_cron poller presents to /api/plaid/sync-due.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
# "1" surfaces the "Connect a bank" UI (Settings + Transactions). Leave unset in
# production until Plaid Production is approved and migration 0004 is applied
# there; the staging deploy sets it to "1".
NEXT_PUBLIC_PLAID_ENABLED=
# E2E / CI ONLY. "1" + PLAID_ENV=sandbox enables POST /api/plaid/test/seed (a
# Link-bypass that mints a Sandbox public_token). 404 otherwise. Never set in a
# real deployment.
PLAID_TEST_SEED_ENABLED=
