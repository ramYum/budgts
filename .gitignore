# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but keep the checked-in template
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# drizzle / supabase local
/supabase/.branches/
/supabase/.temp/

# working screenshots (not deliverables)
/screenshots/

# claude code local settings
.claude/settings.local.json

# stale/scratch brand generator output
/brand/out*/

# local design-inspiration screenshots (reference only, not part of the repo)
*Inspiration Reference/
