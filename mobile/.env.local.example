# Copy to .env.local (or export in your shell) before running `npm start`.
# EXPO_PUBLIC_* vars are inlined into the client bundle by Expo/Metro at
# build time — never put a secret behind this prefix (mirrors the
# NEXT_PUBLIC_* convention in the web app's .env.local.example).

# Same Supabase project as web's NEXT_PUBLIC_SUPABASE_URL.
EXPO_PUBLIC_SUPABASE_URL=
# Same Supabase project as web's NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (sb_publishable_...).
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The deployed Next.js app whose /api/mobile/* routes this client calls with a
# Bearer token (see lib/auth/api.ts). It must be a build that includes the
# mobile API and that a phone can reach (not localhost, not behind Vercel SSO).
EXPO_PUBLIC_API_BASE_URL=

# RevenueCat PUBLIC SDK keys (not secrets). Billing is switched off until
# Phase 4; leave these empty until the RevenueCat project exists.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
