{
  "expo": {
    "name": "Budgts",
    "slug": "budgts",
    "scheme": "budgts",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.budgts.app",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:budgts.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.budgts.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "budgts.com",
              "pathPrefix": "/app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 25
          }
        }
      ],
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F4F4",
          "image": "./assets/splash/egg-xxhdpi.png",
          "imageWidth": 96,
          "android": {
            "mdpi": "./assets/splash/egg-mdpi.png",
            "hdpi": "./assets/splash/egg-hdpi.png",
            "xhdpi": "./assets/splash/egg-xhdpi.png",
            "xxhdpi": "./assets/splash/egg-xxhdpi.png",
            "xxxhdpi": "./assets/splash/egg-xxxhdpi.png"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ab8a69b-67e2-49a5-94dc-5bc9f4d873a5"
      }
    },
    "owner": "budgts"
  }
}
