{
  "name": "budget-tracking-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx tools/check-production-env.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:plaid": "vitest run --config vitest.plaid.config.mts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "predb:migrate": "tsx tools/db/preflight-migrate.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:verify-history": "tsx tools/db/verify-migration-history.ts",
    "screenshot": "node tools/screenshot.mjs",
    "parity": "tsx tools/parity/run.ts",
    "parity:serve": "tsx tools/parity/serve.ts",
    "parity:seed": "tsx tools/parity/seed.ts",
    "parity:web": "tsx tools/parity/capture-web.ts",
    "parity:native": "tsx tools/parity/capture-native.ts",
    "parity:compare": "tsx tools/parity/compare.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.116.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.12",
    "next": "16.3.4",
    "pixelarticons": "^2.4.1",
    "plaid": "^47.0.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-plaid-link": "^5.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
